{
  "openapi": "3.0.3",
  "info": {
    "title": "API сервиса задач",
    "version": "1.1.0",
    "description": "CRUD API для обычных задач и шаблонов периодических задач."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Операции с обычными задачами"
    },
    {
      "name": "Recurring Tasks",
      "description": "Операции с шаблонами периодических задач и генерацией задач"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Получить список задач",
        "responses": {
          "200": {
            "description": "Список задач",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Создать задачу",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Созданная задача",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Получить задачу по ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Задача",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Обновить задачу",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Обновленная задача",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Удалить задачу",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Удалено" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/recurring-tasks": {
      "get": {
        "tags": ["Recurring Tasks"],
        "summary": "Получить список шаблонов периодических задач",
        "responses": {
          "200": {
            "description": "Список шаблонов периодических задач",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/RecurringTask" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Recurring Tasks"],
        "summary": "Создать шаблон периодической задачи",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecurringTaskMutationRequest" },
              "examples": {
                "everyNDays": {
                  "summary": "Каждые 2 дня",
                  "value": {
                    "title": "Обзвон пациентов",
                    "description": "Повторяющаяся задача каждые 2 дня",
                    "active": true,
                    "recurrence": {
                      "type": "every_n_days",
                      "start_date": "2026-04-16T00:00:00Z",
                      "end_date": "2026-04-22T00:00:00Z",
                      "interval_days": 2
                    }
                  }
                },
                "monthlyDay": {
                  "summary": "Ежемесячно 15 числа",
                  "value": {
                    "title": "Инвентаризация",
                    "description": "Ежемесячная инвентаризация",
                    "active": true,
                    "recurrence": {
                      "type": "monthly_day",
                      "end_date": "2026-06-30T00:00:00Z",
                      "day_of_month": 15
                    }
                  }
                },
                "specificDates": {
                  "summary": "Конкретные даты",
                  "value": {
                    "title": "Подготовить отчет",
                    "description": "Задача только на выбранные даты",
                    "active": true,
                    "recurrence": {
                      "type": "specific_dates",
                      "dates": [
                        "2026-04-20T00:00:00Z",
                        "2026-05-20T00:00:00Z"
                      ]
                    }
                  }
                },
                "oddDays": {
                  "summary": "Нечетные дни",
                  "value": {
                    "title": "Обход пациентов",
                    "description": "Обход по нечетным дням месяца",
                    "active": true,
                    "recurrence": {
                      "type": "odd_days"
                    }
                  }
                },
                "endlessDaily": {
                  "summary": "Ежедневная уборка без даты окончания",
                  "value": {
                    "title": "Уборка кабинета",
                    "description": "Ежедневная уборка кабинета без даты окончания",
                    "active": true,
                    "recurrence": {
                      "type": "every_n_days",
                      "start_date": "2026-04-18T00:00:00Z",
                      "interval_days": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Созданный шаблон периодической задачи",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringTask" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/recurring-tasks/generate": {
      "post": {
        "tags": ["Recurring Tasks"],
        "summary": "Ручная генерация задач для бессрочных шаблонов",
        "description": "Используется для бессрочных периодических задач без end_date, например для шаблона 'Уборка кабинета каждый день'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateRecurringTasksRequest" },
              "example": {
                "from_date": "2026-04-16T00:00:00Z",
                "to_date": "2026-04-22T00:00:00Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Сгенерированные задачи",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenerateRecurringTasksResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/recurring-tasks/{id}": {
      "get": {
        "tags": ["Recurring Tasks"],
        "summary": "Получить шаблон периодической задачи по ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Шаблон периодической задачи",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringTask" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Recurring Tasks"],
        "summary": "Обновить шаблон периодической задачи",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecurringTaskMutationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Обновленный шаблон периодической задачи",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringTask" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Recurring Tasks"],
        "summary": "Удалить шаблон периодической задачи",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Удалено" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Некорректный запрос",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Ресурс не найден",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Подготовить релиз"
          },
          "description": {
            "type": "string",
            "example": "Собрать заметки к релизу и проверить миграции"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-18T00:00:00Z"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Подготовить релиз"
          },
          "description": {
            "type": "string",
            "example": "Собрать заметки к релизу и проверить миграции"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-18T00:00:00Z"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Подготовить релиз" },
          "description": {
            "type": "string",
            "example": "Собрать заметки к релизу и проверить миграции"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-18T00:00:00Z"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          }
        }
      },
      "RecurringRecurrence": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["every_n_days", "monthly_day", "specific_dates", "even_days", "odd_days"],
            "example": "every_n_days"
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-16T00:00:00Z"
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T00:00:00Z"
          },
          "interval_days": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "example": 15
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "RecurringTaskMutationRequest": {
        "type": "object",
        "required": ["title", "recurrence"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Обзвон пациентов"
          },
          "description": {
            "type": "string",
            "example": "Периодическая задача для обзвона"
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "recurrence": {
            "$ref": "#/components/schemas/RecurringRecurrence"
          }
        }
      },
      "RecurringTask": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Обзвон пациентов" },
          "description": {
            "type": "string",
            "example": "Периодическая задача для обзвона"
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "recurrence": {
            "$ref": "#/components/schemas/RecurringRecurrence"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-16T10:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-16T10:00:00Z"
          }
        }
      },
      "GenerateRecurringTasksRequest": {
        "type": "object",
        "required": ["from_date", "to_date"],
        "properties": {
          "from_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-16T00:00:00Z"
          },
          "to_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T00:00:00Z"
          }
        }
      },
      "GenerateRecurringTasksResponse": {
        "type": "object",
        "properties": {
          "from_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-16T00:00:00Z"
          },
          "to_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-22T00:00:00Z"
          },
          "generated_count": {
            "type": "integer",
            "example": 2
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "task not found" }
        }
      }
    }
  }
}
